//@version=5
indicator("BBB Indicator (Session Range Breakout)", shorttitle = "BBB", overlay = true, max_boxes_count = 50, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────
grpSession = "Session Range"
sessionString = input.session("0000-0800", "Range Session (e.g. Asian)", group = grpSession)
sessionTZ     = input.string("UTC", "Session Timezone", group = grpSession)
extendBoxBars = input.int(20, "Extend Range Box (bars)", minval = 0, group = grpSession)

grpBreak = "Breakout"
breakoutSource = input.string("Close", "Breakout Confirmed By", options = ["Close", "Wick"], group = grpBreak)
oneSignalPerSession = input.bool(true, "Only First Breakout Per Session", group = grpBreak)

grpRisk = "Risk / Target Calculation"
riskMethod = input.string("Range", "Stop-Loss Method", options = ["Range", "ATR", "Percentage", "Fixed Points"], group = grpRisk)
atrLen     = input.int(14, "ATR Length", minval = 1, group = grpRisk)
atrMult    = input.float(1.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk)
pctValue   = input.float(0.5, "Stop-Loss Percentage (%)", minval = 0.01, step = 0.05, group = grpRisk)
fixedPts   = input.float(50, "Stop-Loss Fixed Points", minval = 0, group = grpRisk)
rrRatio    = input.float(2.0, "Risk : Reward Ratio", minval = 0.1, step = 0.1, group = grpRisk)

grpStyle = "Style"
colRange   = input.color(color.new(color.blue, 85), "Range Box", group = grpStyle)
colUp      = input.color(color.new(color.teal, 0), "Bullish Setup", group = grpStyle)
colDown    = input.color(color.new(color.red, 0), "Bearish Setup", group = grpStyle)
showLabels = input.bool(true, "Show Entry / SL / TP Labels", group = grpStyle)

// ─────────────────────────────────────────────────────────────────────────
// Session range tracking
// ─────────────────────────────────────────────────────────────────────────
inSession = not na(time(timeframe.period, sessionString, sessionTZ))
newSession = inSession and not inSession[1]
sessionEnded = not inSession and inSession[1]

var float rangeHigh = na
var float rangeLow  = na
var int   rangeStartBar = na
var box   rangeBox = na
var bool  rangeReady = false
var bool  signalTakenThisSession = false

if newSession
    rangeHigh := high
    rangeLow := low
    rangeStartBar := bar_index
    rangeReady := false
    signalTakenThisSession := false

if inSession
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)

if sessionEnded
    rangeReady := true
    if not na(rangeBox)
        box.delete(rangeBox)
    rangeBox := box.new(rangeStartBar, rangeHigh, bar_index + extendBoxBars, rangeLow, border_color = color.new(color.blue, 40), bgcolor = colRange, extend = extend.none)

if rangeReady and not na(rangeBox)
    box.set_right(rangeBox, bar_index)

// ─────────────────────────────────────────────────────────────────────────
// Breakout detection
// ─────────────────────────────────────────────────────────────────────────
atrVal = ta.atr(atrLen)

bullBreakSrc = breakoutSource == "Close" ? close : high
bearBreakSrc = breakoutSource == "Close" ? close : low

canSignal = rangeReady and not inSession and (not oneSignalPerSession or not signalTakenThisSession)

bullBreak = canSignal and bullBreakSrc > rangeHigh and bullBreakSrc[1] <= rangeHigh
bearBreak = canSignal and bearBreakSrc < rangeLow and bearBreakSrc[1] >= rangeLow

calcStop(isLong, entryPrice) =>
    float stop = na
    if riskMethod == "Range"
        stop := isLong ? rangeLow : rangeHigh
    else if riskMethod == "ATR"
        stop := isLong ? entryPrice - atrVal * atrMult : entryPrice + atrVal * atrMult
    else if riskMethod == "Percentage"
        stop := isLong ? entryPrice * (1 - pctValue / 100) : entryPrice * (1 + pctValue / 100)
    else
        stop := isLong ? entryPrice - fixedPts : entryPrice + fixedPts
    stop

if bullBreak or bearBreak
    signalTakenThisSession := true

    isLong = bullBreak
    entryPrice = close
    stopPrice = calcStop(isLong, entryPrice)
    riskDist = math.abs(entryPrice - stopPrice)
    targetPrice = isLong ? entryPrice + riskDist * rrRatio : entryPrice - riskDist * rrRatio

    lineColor = isLong ? colUp : colDown
    entryLine  = line.new(bar_index, entryPrice, bar_index + extendBoxBars, entryPrice, color = lineColor, width = 1)
    stopLine   = line.new(bar_index, stopPrice, bar_index + extendBoxBars, stopPrice, color = color.new(color.red, 0), style = line.style_dashed, width = 1)
    targetLine = line.new(bar_index, targetPrice, bar_index + extendBoxBars, targetPrice, color = color.new(color.green, 0), style = line.style_dashed, width = 1)

    if showLabels
        label.new(bar_index, entryPrice, (isLong ? "▲ BUY " : "▼ SELL ") + str.tostring(math.round_to_mintick(entryPrice)) +
             "\nSL: " + str.tostring(math.round_to_mintick(stopPrice)) +
             "\nTP: " + str.tostring(math.round_to_mintick(targetPrice)) +
             "\nR:R 1:" + str.tostring(rrRatio),
             style = isLong ? label.style_label_up : label.style_label_down,
             color = lineColor, textcolor = color.white, size = size.small)

// ─────────────────────────────────────────────────────────────────────────
// Plots & alerts
// ─────────────────────────────────────────────────────────────────────────
plotshape(bullBreak, title = "Bullish Breakout", style = shape.triangleup, location = location.belowbar, color = colUp, size = size.small)
plotshape(bearBreak, title = "Bearish Breakout", style = shape.triangledown, location = location.abovebar, color = colDown, size = size.small)

bgcolor(inSession ? colRange : na, title = "Session Highlight")

alertcondition(bullBreak, title = "BBB Bullish Breakout", message = "BBB: Bullish breakout above session range high")
alertcondition(bearBreak, title = "BBB Bearish Breakout", message = "BBB: Bearish breakout below session range low")
