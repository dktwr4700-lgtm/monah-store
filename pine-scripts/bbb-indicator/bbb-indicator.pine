//@version=5
indicator("BBB Indicator (Session Range Breakout)", shorttitle = "BBB", overlay = true, max_boxes_count = 50, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────
grpSession = "Session Range"
sessionString = input.session("0000-0800", "Range Session (e.g. Asian)", group = grpSession, display = display.data_window)
sessionTZ     = input.string("UTC", "Session Timezone", group = grpSession, display = display.data_window)
extendBoxBars = input.int(20, "Extend Range Box (bars)", minval = 0, group = grpSession, display = display.data_window)

grpBreak = "Breakout"
breakoutSource = input.string("Close", "Breakout Confirmed By", options = ["Close", "Wick"], group = grpBreak, display = display.data_window)
oneSignalPerSession = input.bool(true, "Only First Breakout Per Session", group = grpBreak, display = display.data_window)

grpRisk = "Risk / Target Calculation"
riskMethod = input.string("Range", "Stop-Loss Method", options = ["Range", "ATR", "Percentage", "Fixed Points"], group = grpRisk, display = display.data_window)
atrLen     = input.int(14, "ATR Length", minval = 1, group = grpRisk, display = display.data_window)
atrMult    = input.float(1.0, "ATR Multiplier", minval = 0.1, step = 0.1, group = grpRisk, display = display.data_window)
pctValue   = input.float(0.5, "Stop-Loss Percentage (%)", minval = 0.01, step = 0.05, group = grpRisk, display = display.data_window)
fixedPts   = input.float(50, "Stop-Loss Fixed Points", minval = 0, group = grpRisk, display = display.data_window)

targetMethod  = input.string("Fixed Points", "Take-Profit Method", options = ["Fixed Points", "R:R Ratio"], group = grpRisk, display = display.data_window)
tpFixedPoints = input.float(100, "Take-Profit Fixed Points", minval = 0, group = grpRisk, display = display.data_window)
rrRatio       = input.float(2.0, "Risk : Reward Ratio (used if method = R:R Ratio)", minval = 0.1, step = 0.1, group = grpRisk, display = display.data_window)

grpStyle = "Style"
colRange   = input.color(color.new(color.blue, 85), "Range Box", group = grpStyle, display = display.data_window)
colUp      = input.color(color.new(color.teal, 0), "Bullish Setup", group = grpStyle, display = display.data_window)
colDown    = input.color(color.new(color.red, 0), "Bearish Setup", group = grpStyle, display = display.data_window)
showTags   = input.bool(true, "Show SL / TP Tags on Chart", group = grpStyle, display = display.data_window)
tagOffsetBars = input.int(3, "Tag Offset (bars after breakout)", minval = 1, group = grpStyle, display = display.data_window)

// ─────────────────────────────────────────────────────────────────────────
// Session range tracking
// ─────────────────────────────────────────────────────────────────────────
inSession = not na(time(timeframe.period, sessionString, sessionTZ))
newSession = inSession and not inSession[1]
sessionEnded = not inSession and inSession[1]

var float rangeHigh = na
var float rangeLow  = na
var int   rangeStartBar = na
var box   rangeBox = na
var bool  rangeReady = false
var bool  signalTakenThisSession = false

if newSession
    rangeHigh := high
    rangeLow := low
    rangeStartBar := bar_index
    rangeReady := false
    signalTakenThisSession := false

if inSession
    rangeHigh := math.max(rangeHigh, high)
    rangeLow := math.min(rangeLow, low)

if sessionEnded
    rangeReady := true
    if not na(rangeBox)
        box.delete(rangeBox)
    rangeBox := box.new(rangeStartBar, rangeHigh, bar_index + extendBoxBars, rangeLow, border_color = color.new(color.blue, 40), bgcolor = colRange, extend = extend.none)

if rangeReady and not na(rangeBox)
    box.set_right(rangeBox, bar_index)

// ─────────────────────────────────────────────────────────────────────────
// Breakout detection
// ─────────────────────────────────────────────────────────────────────────
atrVal = ta.atr(atrLen)

bullBreakSrc = breakoutSource == "Close" ? close : high
bearBreakSrc = breakoutSource == "Close" ? close : low

canSignal = rangeReady and not inSession and (not oneSignalPerSession or not signalTakenThisSession)

bullBreak = canSignal and bullBreakSrc > rangeHigh and bullBreakSrc[1] <= rangeHigh
bearBreak = canSignal and bearBreakSrc < rangeLow and bearBreakSrc[1] >= rangeLow

calcStop(isLong, entryPrice) =>
    float stop = na
    if riskMethod == "Range"
        stop := isLong ? rangeLow : rangeHigh
    else if riskMethod == "ATR"
        stop := isLong ? entryPrice - atrVal * atrMult : entryPrice + atrVal * atrMult
    else if riskMethod == "Percentage"
        stop := isLong ? entryPrice * (1 - pctValue / 100) : entryPrice * (1 + pctValue / 100)
    else
        stop := isLong ? entryPrice - fixedPts : entryPrice + fixedPts
    stop

if bullBreak or bearBreak
    signalTakenThisSession := true

    isLong = bullBreak
    entryPrice = close
    stopPrice = calcStop(isLong, entryPrice)
    riskDist = math.abs(entryPrice - stopPrice)
    targetPrice = targetMethod == "Fixed Points" ?
         (isLong ? entryPrice + tpFixedPoints : entryPrice - tpFixedPoints) :
         (isLong ? entryPrice + riskDist * rrRatio : entryPrice - riskDist * rrRatio)

    sideColor = isLong ? colUp : colDown
    tagBar = bar_index + tagOffsetBars

    // Small BUY/SELL tag right on the breakout bar, offset above/below so it doesn't sit on the candle body.
    label.new(bar_index, isLong ? low : high, isLong ? "BUY" : "SELL",
         yloc = isLong ? yloc.belowbar : yloc.abovebar,
         style = isLong ? label.style_label_up : label.style_label_down,
         color = sideColor, textcolor = color.white, size = size.small)

    if showTags
        // Short stub + a small tag fixed a few bars after the breakout — it stays put, it never
        // extends further as new bars form.
        line.new(bar_index, stopPrice, tagBar, stopPrice, color = colDown, style = line.style_dashed, width = 1)
        line.new(bar_index, targetPrice, tagBar, targetPrice, color = colUp, style = line.style_dashed, width = 1)
        label.new(tagBar, stopPrice, "🛑 SL " + str.tostring(math.round_to_mintick(stopPrice)),
             style = label.style_label_left, color = colDown, textcolor = color.white, size = size.small)
        label.new(tagBar, targetPrice, "🎯 TP " + str.tostring(math.round_to_mintick(targetPrice)),
             style = label.style_label_left, color = colUp, textcolor = color.white, size = size.small)

// ─────────────────────────────────────────────────────────────────────────
// Background & alerts
// ─────────────────────────────────────────────────────────────────────────
bgcolor(inSession ? colRange : na, title = "Session Highlight")

alertcondition(bullBreak, title = "BBB Bullish Breakout", message = "BBB: Bullish breakout above session range high")
alertcondition(bearBreak, title = "BBB Bearish Breakout", message = "BBB: Bearish breakout below session range low")
