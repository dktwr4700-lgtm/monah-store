//
// Buying / Selling Pressure estimate — NOT a count of real traders (that
// data does not exist for CFD instruments like US30/US500, which trade
// through a broker rather than a central exchange). This estimates which
// side is more dominant using each candle's close position within its
// range, weighted by tick volume (the only volume data available on a
// CFD feed). Treat it as supporting context next to your other
// indicators, not as a signal on its own.
//@version=5
indicator(
     "Buying / Selling Pressure (Estimate)",
     shorttitle = "PRESSURE",
     overlay = true,
     max_labels_count = 50)

// ─────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────
grpCalc = "Calculation"
pressureLookback = input.int(
     20, "Lookback Bars", minval = 1, group = grpCalc)

grpStyle = "Style"
showBackground = input.bool(
     true, "Tint Background by Pressure", group = grpStyle)
showLabel = input.bool(
     true, "Show Buy/Sell % Label", group = grpStyle)
buyColor = input.color(
     color.new(color.teal, 0), "Buying Pressure Color", group = grpStyle)
sellColor = input.color(
     color.new(color.red, 0), "Selling Pressure Color", group = grpStyle)

// ─────────────────────────────────────────────────────────────────────────
// Close-location-value weighted by volume (same idea Chaikin Money Flow
// uses): a close near the bar's high with strong volume counts as buying
// pressure, a close near the low counts as selling pressure.
// ─────────────────────────────────────────────────────────────────────────
barRange = high - low
clv = barRange == 0 ? 0.0 : ((close - low) - (high - close)) / barRange
moneyFlowVol = clv * volume

buyFlow = moneyFlowVol > 0 ? moneyFlowVol : 0.0
sellFlow = moneyFlowVol < 0 ? -moneyFlowVol : 0.0

sumBuy = math.sum(buyFlow, pressureLookback)
sumSell = math.sum(sellFlow, pressureLookback)
totalFlow = sumBuy + sumSell

buyPct = totalFlow == 0 ? 50.0 : (sumBuy / totalFlow) * 100
sellPct = 100 - buyPct

// ─────────────────────────────────────────────────────────────────────────
// Display — a soft background tint plus a compact Arabic label at the
// last bar. Redraws every bar on purpose: this is a live estimate, not
// a fixed historical level, so it should always reflect the latest data.
// ─────────────────────────────────────────────────────────────────────────
bgColor = not showBackground ? na :
     buyPct > 55 ? color.new(buyColor, 88) :
     sellPct > 55 ? color.new(sellColor, 88) : na
bgcolor(bgColor, title = "Pressure Background")

var label pressureLabel = na
if showLabel and barstate.islast
    if not na(pressureLabel)
        label.delete(pressureLabel)

    buyText = str.tostring(math.round(buyPct, 0))
    sellText = str.tostring(math.round(sellPct, 0))
    labelText = "🟢 شراء " + buyText + "% | 🔴 بيع " + sellText + "%"
    pressureLabel := label.new(
         bar_index + 3,
         high,
         labelText,
         style = label.style_label_left,
         color = color.new(color.black, 20),
         textcolor = color.white,
         size = size.small)
